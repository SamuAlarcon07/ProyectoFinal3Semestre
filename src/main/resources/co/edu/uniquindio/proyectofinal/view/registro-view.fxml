<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyectofinal.viewcontroller.RegistroViewController"
            styleClass="app-background">

    <left>
        <VBox alignment="CENTER_LEFT"
              spacing="22.0"
              styleClass="brand-panel">
            <padding>
                <Insets top="52" right="48" bottom="52" left="58"/>
            </padding>

            <VBox spacing="2">
                <Label text="CINEMA" styleClass="brand-title"/>
                <Label text="UQ" styleClass="brand-mark"/>
            </VBox>

            <VBox spacing="10">
                <Label text="Haz espacio" styleClass="hero-title"/>
                <Label text="para nuevas historias."
                       styleClass="hero-title-accent"/>
                <Label text="Crea tu cuenta y ten a la mano tus películas, entradas y próximas experiencias."
                       wrapText="true"
                       styleClass="hero-description"
                       maxWidth="390"/>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="hero-pill">
                <Label text="✦" styleClass="hero-star"/>
                <Label text="Una cuenta. Muchas historias."
                       styleClass="hero-pill-text"/>
            </HBox>

            <Label text="UNIVERSIDAD DEL QUINDÍO · CINEMA EXPERIENCE"
                   styleClass="brand-footer"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" styleClass="form-area">
            <VBox spacing="12"
                  maxWidth="410"
                  styleClass="form-card form-card-compact">

                <VBox spacing="6">
                    <Label text="Crear cuenta" styleClass="form-title"/>
                    <Label text="Completa tus datos para registrarte como cliente."
                           styleClass="form-subtitle"
                           wrapText="true"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Identificación" styleClass="field-label"/>
                    <TextField fx:id="identificacionField"
                               promptText="Número de identificación"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Nombre completo" styleClass="field-label"/>
                    <TextField fx:id="nombreField"
                               promptText="Tu nombre"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Correo electrónico" styleClass="field-label"/>
                    <TextField fx:id="correoField"
                               promptText="nombre@correo.com"
                               styleClass="input-field"/>
                </VBox>

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Contraseña" styleClass="field-label"/>
                        <PasswordField fx:id="contrasenaField"
                                       promptText="Mínimo 8 caracteres"
                                       styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Confirmar" styleClass="field-label"/>
                        <PasswordField fx:id="confirmarContrasenaField"
                                       promptText="Repite la contraseña"
                                       styleClass="input-field"
                                       onAction="#registrarCliente"/>
                    </VBox>
                </HBox>

                <Label fx:id="mensajeLabel"
                       text=" "
                       wrapText="true"
                       minHeight="30"
                       styleClass="message-label"/>

                <Button text="Crear mi cuenta"
                        onAction="#registrarCliente"
                        maxWidth="Infinity"
                        styleClass="button-primary"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="¿Ya tienes una cuenta?"
                           styleClass="helper-text"/>
                    <Button text="Inicia sesión"
                            onAction="#volverAlLogin"
                            styleClass="button-link"/>
                </HBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>
